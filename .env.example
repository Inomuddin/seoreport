# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///seoreport.db

# ─── Google PageSpeed API ─────────────────────────────────────────────────────
# Get free key at: https://console.cloud.google.com/apis/library/pagespeedonline.googleapis.com
GOOGLE_PAGESPEED_API_KEY=your-google-api-key-here

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs (create these in Stripe dashboard)
STRIPE_STARTER_PRICE_ID=price_starter
STRIPE_AGENCY_PRICE_ID=price_agency
STRIPE_PRO_PRICE_ID=price_pro

# ─── Email ────────────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=SEO Report
BASE_URL=http://localhost:5000
